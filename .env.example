# Copy to .env and fill in. .env is gitignored and no key has ever been committed.
# Keys are read from the environment only. Nothing here reaches the browser: the
# frontend talks to this backend, and only this backend talks to a model.

# ---------------------------------------------------------------- required

# Jev / TypeSafe. Every decision in this repository is one of these calls.
# https://typesafe.ai
JEV_API_KEY=apikey_...

# OpenAI. Vision only (gpt-4o-mini reads the creator's pictures) and speech only
# (voice-note transcription). It never decides anything.
# Needed by: scripts/enrich_images.py, scripts/transcribe_voice.py,
#            scripts/vision_to_jev.py, backend at request time for live voice.
# The committed cache already holds every vision and voice result, so the demo
# runs without this key. You only need it to re-read images or re-transcribe.
OPENAI_API_KEY=sk-proj-...

# ---------------------------------------------------------------- optional

# Switches, all with working defaults. Set one only if you are reproducing a
# specific measurement.

# backend/corpora.py. 0 removes the creator's pictures from the judge state,
# which is how the with-pictures and without-pictures comparison is reproduced.
# CORPUS_IMAGES=1

# scripts/engine_decontaminated_v2.py. How many times each extraction is
# repeated. One run is not a measurement. docs/11 was produced at 5.
# DECON_REPEATS=3

# scripts/engine_decontaminated_v2.py. 1 is the fully decontaminated shelf.
# DECON_OBJECTIVE_SHELF=1

# backend/engine.py. Caps how many messages the gap probe reads. 0 is off.
# GAP_PROBE_MESSAGES=0

# ---------------------------------------------------------------- not used
#
# DEEPSEEK_API_KEY was evaluated during the build and no code reads it. It is
# mentioned in docs/01 and nowhere else. Do not add it.
#
# Modal reads JEV_API_KEY from a Modal secret, not from this file:
#   modal secret create jev JEV_API_KEY=apikey_...
